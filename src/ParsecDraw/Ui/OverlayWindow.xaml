<!-- Background 不能用 Transparent(alpha=0)：全透明像素在 OS 命中测试里不可点击，真实鼠标永远穿底 -->
<Window x:Class="ParsecDraw.Ui.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:draw="clr-namespace:ParsecDraw.Draw"
        Title="ParsecDraw Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Left="0" Top="0" Width="1920" Height="1080">
    <Grid>
        <draw:DrawCanvas x:Name="Canvas" />
        <!-- 对齐参考框：映射矩形变化/进绘画态时短暂闪现，提示可画区域 -->
        <Rectangle x:Name="MapGuide" Stroke="#B04DA3FF" StrokeThickness="2"
                   StrokeDashArray="6 4" StrokeDashCap="Round"
                   IsHitTestVisible="False" Opacity="0" />
    </Grid>
</Window>
