<Window x:Class="ParsecDraw.Ui.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:draw="clr-namespace:ParsecDraw.Draw"
        Title="ParsecDraw Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Left="0" Top="0" Width="1920" Height="1080">
    <draw:DrawCanvas x:Name="Canvas" />
</Window>
