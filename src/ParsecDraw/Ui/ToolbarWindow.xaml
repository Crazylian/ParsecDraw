<Window x:Class="ParsecDraw.Ui.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ParsecDraw Toolbar"
        Icon="/Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        MouseEnter="OnToolbarMouseEnter"
        MouseLeave="OnToolbarMouseLeave">
    <Border Background="#F01E1E28" CornerRadius="12" Padding="10,8"
            BorderBrush="#3AFFFFFF" BorderThickness="1"
            MouseLeftButtonDown="OnDragMove">
        <StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 模式指示 -->
                <Border x:Name="ModeBadge" Background="#334DA3FF" CornerRadius="6" Padding="8,4" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="ModeText" Foreground="#FFBFD8FF" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" Text="绘画" />
                </Border>

                <!-- 观众端绘制工具：画笔/激光/橡皮 三选一 -->
                <StackPanel x:Name="DrawTools" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPen" Content="✏ 画笔" Style="{StaticResource TbTool}" Margin="0,0,4,0" Click="OnPen" />
                    <Button x:Name="BtnLaser" Content="◆ 激光" Style="{StaticResource TbTool}" Margin="0,0,4,0" Click="OnLaser" />
                    <Button x:Name="BtnEraser" Content="▢ 橡皮" Style="{StaticResource TbTool}" Margin="0,0,0,0" Click="OnEraser"
                            ToolTip="整笔擦除，只能擦自己的笔迹（拖动扫过要擦的线）" />

                    <Rectangle Style="{StaticResource TbSep}" />

                    <StackPanel x:Name="ColorsPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                    <StackPanel x:Name="WidthsPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0" />
                    <Button x:Name="BtnUndo" Content="↶ 撤销" Style="{StaticResource TbTool}" Click="OnUndo" />
                </StackPanel>

                <Rectangle x:Name="SepCommon" Style="{StaticResource TbSep}" />

                <!-- 通用动作：钉住模式（开关样式）/ 清空 -->
                <Button x:Name="BtnPin" Content="◎ 钉住" Style="{StaticResource TbTool}" Margin="0,0,4,0" Click="OnPin"
                        ToolTip="开启后新画的笔迹持久保留，关闭后恢复自动淡出（Ctrl+Alt+P）" />
                <Button x:Name="BtnClear" Content="✕ 清空" Style="{StaticResource TbTool}" Margin="0,0,4,0" Click="OnClear" />
                <Button x:Name="BtnToggle" Content="暂停" Style="{StaticResource TbTool}" Margin="0,0,4,0" Click="OnToggle" />

                <!-- 观众端：退出绘画态 -->
                <Button x:Name="BtnExitDraw" Content="完成" Style="{StaticResource TbToolPrimary}" Click="OnExitDraw" />
            </StackPanel>
            <TextBlock x:Name="HintText" Foreground="#FF8A8AA2" FontSize="11" Margin="2,6,0,0" TextWrapping="Wrap"
                       Text="" />
        </StackPanel>
    </Border>
</Window>
