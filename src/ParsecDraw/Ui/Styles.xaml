<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="TbBorder" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="TbAccent" Color="#FF4DA3FF" />
    <SolidColorBrush x:Key="WinBg" Color="#FF1E1E28" />
    <SolidColorBrush x:Key="PanelBg" Color="#FF2A2A36" />
    <SolidColorBrush x:Key="Fg" Color="#FFEAEAF2" />
    <SolidColorBrush x:Key="FgDim" Color="#FF8888A0" />

    <!-- 工具栏小按钮（旧键保留：颜色点等动态创建的按钮用） -->
    <Style x:Key="TbButton" TargetType="Button">
        <Setter Property="Background" Value="#FF3A3A4A" />
        <Setter Property="Foreground" Value="#FFEAEAF2" />
        <Setter Property="BorderBrush" Value="{StaticResource TbBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 工具栏工具按钮：圆角、悬停反馈、选中态由代码改 Background/Border -->
    <Style x:Key="TbTool" TargetType="Button">
        <Setter Property="Background" Value="#003A3A4A" />
        <Setter Property="Foreground" Value="#FFD6D6E4" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 工具栏主按钮（完成） -->
    <Style x:Key="TbToolPrimary" TargetType="Button" BasedOn="{StaticResource TbTool}">
        <Setter Property="Foreground" Value="#FF0F1524" />
        <Setter Property="Background" Value="#FF4DA3FF" />
        <Setter Property="BorderBrush" Value="#FF4DA3FF" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 工具栏分组分隔线 -->
    <Style x:Key="TbSep" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="Fill" Value="#26FFFFFF" />
        <Setter Property="Margin" Value="9,4" />
        <Setter Property="RadiusX" Value="0.5" />
        <Setter Property="RadiusY" Value="0.5" />
    </Style>

    <!-- 控制窗常规按钮 -->
    <Style x:Key="MainButton" TargetType="Button">
        <Setter Property="Background" Value="#FF3A3A4A" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="BorderBrush" Value="{StaticResource TbBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
        <Setter Property="Background" Value="#FF2F5FA8" />
        <Setter Property="BorderBrush" Value="#FF4DA3FF" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Background" Value="#FF16161E" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="BorderBrush" Value="#FF44445A" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CaretBrush" Value="{StaticResource Fg}" />
    </Style>

    <Style x:Key="DimText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FgDim}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

</ResourceDictionary>
