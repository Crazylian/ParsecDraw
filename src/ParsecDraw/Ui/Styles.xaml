<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="TbBorder" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="WinBg" Color="#FF1E1E28" />
    <SolidColorBrush x:Key="PanelBg" Color="#FF2A2A36" />
    <SolidColorBrush x:Key="Fg" Color="#FFEAEAF2" />
    <SolidColorBrush x:Key="FgDim" Color="#FF8888A0" />

    <!-- ===== 工具栏（横向画具托盘）视觉基元 ===== -->

    <!-- 图标几何：24 网格线稿，经 TbIcon 以 16px 呈现，描边色跟随宿主按钮前景 -->
    <StreamGeometry x:Key="GeoPen">M 17 3 A 2.85 2.83 0 1 1 21 7 L 7.5 20.5 L 2 22 L 3.5 16.5 Z</StreamGeometry>
    <!-- 激光：中心亮点由按钮里的 Ellipse 叠加，这里只有射线 -->
    <StreamGeometry x:Key="GeoLaser">M 12 3.2 L 12 5.8 M 12 18.2 L 12 20.8 M 3.2 12 L 5.8 12 M 18.2 12 L 20.8 12 M 5.9 5.9 L 7.7 7.7 M 16.3 16.3 L 18.1 18.1 M 18.1 5.9 L 16.3 7.7 M 7.7 16.3 L 5.9 18.1</StreamGeometry>
    <StreamGeometry x:Key="GeoEraser">M 7 21 L 2.7 16.7 C 1.7 15.7 1.7 14.2 2.7 13.3 L 12.3 3.7 C 13.3 2.7 14.8 2.7 15.7 3.7 L 21.3 9.3 C 22.3 10.3 22.3 11.8 21.3 12.7 L 13 21 M 22 21 L 7 21 M 5 11 L 14 20</StreamGeometry>
    <StreamGeometry x:Key="GeoUndo">M 9 14 L 4 9 L 9 4 M 4 9 L 14.5 9 A 5.5 5.5 0 0 1 20 14.5 A 5.5 5.5 0 0 1 14.5 20 L 11 20</StreamGeometry>
    <StreamGeometry x:Key="GeoPin">M 12 17 L 12 22 M 9 10.76 A 2 2 0 0 1 7.89 12.55 L 6.11 13.45 A 2 2 0 0 0 5 15.24 L 5 16 A 1 1 0 0 0 6 17 L 18 17 A 1 1 0 0 0 19 16 L 19 15.24 A 2 2 0 0 1 17.89 13.45 L 16.11 12.55 A 2 2 0 0 1 15 10.76 L 15 7 A 1 1 0 0 1 16 6 A 2 2 0 0 0 16 2 L 8 2 A 2 2 0 0 0 8 6 A 1 1 0 0 1 9 7 Z</StreamGeometry>
    <StreamGeometry x:Key="GeoClear">M 3 6 L 21 6 M 19 6 L 19 20 C 19 21 18 22 17 22 L 7 22 C 6 22 5 21 5 20 L 5 6 M 8 6 L 8 4 C 8 3 9 2 10 2 L 14 2 C 15 2 16 3 16 4 L 16 6 M 10 11 L 10 17 M 14 11 L 14 17</StreamGeometry>
    <StreamGeometry x:Key="GeoHelp">M 22 12 A 10 10 0 1 1 2 12 A 10 10 0 1 1 22 12 M 9.09 9 A 3 3 0 0 1 14.92 10 C 14.92 12 11.92 13 11.92 13 M 12 17 L 12.01 17</StreamGeometry>
    <StreamGeometry x:Key="GeoPause">M 9.5 5 L 9.5 19 M 14.5 5 L 14.5 19</StreamGeometry>
    <StreamGeometry x:Key="GeoEye">M 2 12 C 4 8.2 7.5 5 12 5 C 16.5 5 20 8.2 22 12 C 20 15.8 16.5 19 12 19 C 7.5 19 4 15.8 2 12 Z</StreamGeometry>
    <!-- 主机角色卡：手柄（形状宽扁，显示尺寸放大到 34px 与画笔等视觉重量） -->
    <StreamGeometry x:Key="GeoPad">M 7.2 7 L 16.8 7 C 19.3 7 21 8.9 21 11.6 C 21 14.2 20 16 18.1 16 C 16.6 16 15.9 15 14.5 15 L 9.5 15 C 8.1 15 7.4 16 5.9 16 C 4 16 3 14.2 3 11.6 C 3 8.9 4.7 7 7.2 7 Z M 8.6 9.7 L 8.6 13.1 M 6.9 11.4 L 10.3 11.4 M 15.6 10.6 L 15.61 10.6 M 17.8 12.4 L 17.81 12.4</StreamGeometry>

    <!-- 线性图标：描边随宿主按钮的前景色（选中/开关态换色只动按钮 Foreground） -->
    <Style x:Key="TbIcon" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="StrokeThickness" Value="1.33" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>

    <!-- 托盘图标按钮（34px 圆角方）：选中/开关态由代码改 Background/Foreground/BorderBrush -->
    <Style x:Key="TbToolBtn" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFC9C9DB" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- 热键速查等长提示需要足够悬停时长 -->
        <Setter Property="ToolTipService.ShowDuration" Value="15000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 色点/粗细点按钮：透明底、无框；选中光环是内容 Grid 里的 Ellipse，由代码切换可见性 -->
    <Style x:Key="TbDotBtn" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTipService.ShowDuration" Value="15000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 工具栏分组分隔线 -->
    <Style x:Key="TbSep" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="Fill" Value="#30FFFFFF" />
        <Setter Property="Margin" Value="5,3" />
        <Setter Property="RadiusX" Value="0.5" />
        <Setter Property="RadiusY" Value="0.5" />
    </Style>

    <!-- 角色选择卡（控制窗）：悬停=描边与图标亮品牌蓝，延续工具栏选中语言 -->
    <Style x:Key="RoleCard" TargetType="Button">
        <Setter Property="Background" Value="#EE1C1C28" />
        <Setter Property="BorderBrush" Value="#36FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FFC9C9DB" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="16,18,16,15">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FF4DA3FF" />
                            <Setter TargetName="Bd" Property="Background" Value="#1A4DA3FF" />
                            <Setter Property="Foreground" Value="#FF4DA3FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 控制窗常规按钮 -->
    <Style x:Key="MainButton" TargetType="Button">
        <Setter Property="Background" Value="#FF3A3A4A" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="BorderBrush" Value="{StaticResource TbBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource MainButton}">
        <Setter Property="Background" Value="#FF2F5FA8" />
        <Setter Property="BorderBrush" Value="#FF4DA3FF" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Background" Value="#FF16161E" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="BorderBrush" Value="#FF44445A" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CaretBrush" Value="{StaticResource Fg}" />
    </Style>

    <Style x:Key="DimText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FgDim}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

</ResourceDictionary>
