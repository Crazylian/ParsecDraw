<Window x:Class="ParsecDraw.Ui.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ParsecDraw — 观战画笔"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WinBg}"
        ResizeMode="NoResize">
    <StackPanel Margin="18,14,18,16">

        <TextBlock Text="ParsecDraw" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Fg}" />
        <TextBlock Style="{StaticResource DimText}" Margin="1,2,0,14"
                   Text="朋友观战时的画笔互动层：笔迹纯覆盖层同步，绝不向玩家机器注入任何输入" />

        <!-- 角色选择 -->
        <StackPanel x:Name="RolePanel">
            <Button x:Name="BtnHost" Style="{StaticResource MainButton}" Margin="0,0,0,8"
                    HorizontalContentAlignment="Left" Click="OnChooseHost">
                <StackPanel>
                    <TextBlock Text="我是主机（被观看 · 玩游戏）" FontWeight="SemiBold" />
                    <TextBlock FontSize="11" Foreground="{StaticResource FgDim}"
                               Text="启动共享服务，本机屏幕上显示笔迹覆盖层并随 Parsec 串流出去" />
                </StackPanel>
            </Button>
            <Button x:Name="BtnViewer" Style="{StaticResource MainButton}"
                    HorizontalContentAlignment="Left" Click="OnChooseViewer">
                <StackPanel>
                    <TextBlock Text="我是观众（画画 · 看别人玩）" FontWeight="SemiBold" />
                    <TextBlock FontSize="11" Foreground="{StaticResource FgDim}"
                               Text="连接主机，在 Parsec 画面上直接画线指点" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- 主机面板 -->
        <StackPanel x:Name="HostPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource DimText}" Margin="1,0,0,6" Text="把下面的地址发给观众（点击行复制）：" />
            <ListBox x:Name="IpList" Background="{StaticResource PanelBg}" Foreground="{StaticResource Fg}"
                     BorderBrush="#FF44445A" MaxHeight="110" FontSize="13"
                     SelectionChanged="OnIpSelected" />
            <TextBlock Style="{StaticResource DimText}" Margin="1,8,0,0" Text="状态" />
            <TextBlock x:Name="HostStatus" Foreground="{StaticResource Fg}" FontSize="13" Margin="1,2,0,0" TextWrapping="Wrap"
                       Text="未启动" />
            <Button Style="{StaticResource MainButton}" Margin="0,12,0,0" Click="OnStopSession" Content="结束会话" />
        </StackPanel>

        <!-- 观众面板 -->
        <StackPanel x:Name="ViewerPanel" Visibility="Collapsed">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="地址" Style="{StaticResource DimText}" VerticalAlignment="Center" />
                <TextBox x:Name="UrlBox" Grid.Column="1" Style="{StaticResource InputBox}"
                         TextChanged="OnSettingChanged" />
            </Grid>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="昵称" Style="{StaticResource DimText}" VerticalAlignment="Center" />
                <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource InputBox}"
                         TextChanged="OnSettingChanged" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Ellipse x:Name="ConnDot" Width="10" Height="10" Fill="#FF8888A0" VerticalAlignment="Center" Margin="1,0,6,0" />
                <TextBlock x:Name="ViewerStatus" Foreground="{StaticResource Fg}" FontSize="13"
                           VerticalAlignment="Center" Text="未连接" />
            </StackPanel>
            <TextBlock x:Name="HostAddresses" Style="{StaticResource DimText}" Margin="1,8,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed" />
            <Button x:Name="BtnConnect" Style="{StaticResource AccentButton}" Margin="0,12,0,0" Content="连接" Click="OnConnect" />
            <Button Style="{StaticResource MainButton}" Margin="0,8,0,0" Content="断开并返回" Click="OnStopSession" />
        </StackPanel>

        <TextBlock x:Name="HintLine" Style="{StaticResource DimText}" Margin="1,14,0,0" TextWrapping="Wrap"
                   Text="提示：游戏请用无边框窗口模式（独占全屏会盖住覆盖层）；跨公网请用 Tailscale 等先打通网络。" />
    </StackPanel>
</Window>
