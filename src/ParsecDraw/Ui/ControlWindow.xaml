<ui:FluentWindow x:Class="ParsecDraw.Ui.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ParsecDraw — 观战画笔"
        Icon="/Assets/app.ico"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        Background="#F216161E"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏：ui:TitleBar 提供关闭/最小化按钮与拖拽区（ExtendsContentIntoTitleBar 必须配它） -->
        <ui:TitleBar Grid.Row="0" Title="ParsecDraw" Icon="/Assets/app.ico" Height="44" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,6,20,18">

                <!-- 角色选择：左右并排双卡，悬停亮品牌蓝（与工具栏同一套视觉） -->
                <StackPanel x:Name="RolePanel" Margin="0,6,0,0">
                    <TextBlock Text="你是哪一边？" FontSize="14" FontWeight="SemiBold" Foreground="#FFEAEAF2"
                               Margin="1,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnHost" Grid.Column="0" Style="{StaticResource RoleCard}" Click="OnChooseHost">
                            <StackPanel>
                                <!-- 手柄宽扁、画笔对角饱满：显示尺寸 34/27 + 同 1.9 线宽做视觉等重；固定高容器保证两卡标题起点对齐 -->
                                <Grid Height="34" Margin="0,0,0,10">
                                    <Path Style="{StaticResource TbIcon}" Width="34" Height="34" StrokeThickness="1.9"
                                          Data="{StaticResource GeoPad}" />
                                </Grid>
                                <TextBlock Text="我是主机" FontSize="14" FontWeight="SemiBold" Foreground="#FFEAEAF2" />
                                <TextBlock Text="我在这台电脑上玩游戏" FontSize="11.5" Foreground="#FF9C9CB4"
                                           Margin="0,5,0,0" />
                                <Rectangle Height="1" Fill="#22FFFFFF" Margin="0,9,0,0" />
                                <TextBlock Text="点击后：列出地址，发给朋友" FontSize="11" Foreground="#FF6E6E88"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnViewer" Grid.Column="2" Style="{StaticResource RoleCard}" Click="OnChooseViewer">
                            <StackPanel>
                                <Grid Height="34" Margin="0,0,0,10">
                                    <Path Style="{StaticResource TbIcon}" Width="27" Height="27" StrokeThickness="1.9"
                                          Data="{StaticResource GeoPen}" />
                                </Grid>
                                <TextBlock Text="我是观众" FontSize="14" FontWeight="SemiBold" Foreground="#FFEAEAF2" />
                                <TextBlock Text="我在朋友的画面上画线指点" FontSize="11.5" Foreground="#FF9C9CB4"
                                           Margin="0,5,0,0" />
                                <Rectangle Height="1" Fill="#22FFFFFF" Margin="0,9,0,0" />
                                <TextBlock Text="点击后：填入主机地址并连接" FontSize="11" Foreground="#FF6E6E88"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- 主机面板 -->
                <StackPanel x:Name="HostPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource DimText}" Margin="1,0,0,6" Text="把下面的地址发给观众（点击行复制）：" />
                    <ui:ListView x:Name="IpList" MaxHeight="130" FontSize="13"
                                 SelectionChanged="OnIpSelected" />
                    <TextBlock Style="{StaticResource DimText}" Margin="1,10,0,0" Text="状态" />
                    <TextBlock x:Name="HostStatus" Foreground="#FFEAEAF2" FontSize="13" Margin="1,2,0,0" TextWrapping="Wrap"
                               Text="未启动" />
                    <ui:Button Appearance="Danger" Margin="0,14,0,0" HorizontalAlignment="Stretch" Click="OnStopSession"
                               Content="结束会话" />
                </StackPanel>

                <!-- 观众面板 -->
                <StackPanel x:Name="ViewerPanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="地址" Style="{StaticResource DimText}" VerticalAlignment="Center" />
                        <ui:TextBox x:Name="UrlBox" Grid.Column="1" TextChanged="OnSettingChanged"
                                    PlaceholderText="ws://192.168.1.10:8765" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="昵称" Style="{StaticResource DimText}" VerticalAlignment="Center" />
                        <ui:TextBox x:Name="NameBox" Grid.Column="1" TextChanged="OnSettingChanged"
                                    PlaceholderText="朋友看到的名字" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse x:Name="ConnDot" Width="10" Height="10" Fill="#FF8888A0" VerticalAlignment="Center" Margin="1,0,6,0" />
                        <TextBlock x:Name="ViewerStatus" Foreground="#FFEAEAF2" FontSize="13"
                                   VerticalAlignment="Center" Text="未连接" />
                    </StackPanel>
                    <ui:Button Appearance="Primary" Margin="0,14,0,0" HorizontalAlignment="Stretch" Content="连接"
                               Click="OnConnect" />
                    <ui:Button Appearance="Secondary" Margin="0,8,0,0" HorizontalAlignment="Stretch" Content="断开并返回"
                               Click="OnStopSession" />
                </StackPanel>

                <TextBlock x:Name="HintLine" Style="{StaticResource DimText}" Margin="1,16,0,0" TextWrapping="Wrap"
                           Text="提示：游戏请用无边框窗口模式（独占全屏会盖住覆盖层）；跨公网请用 Tailscale 等先打通网络。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
